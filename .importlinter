# The library holds no schema and no ORM: everything durable reaches it
# through the ports the host application implements. CI runs `lint-imports`
# over the real import graph, so an indirect chain is caught as well as a
# direct import.
[importlinter]
include_external_packages = True
root_packages =
    webauth

[importlinter:contract:webauth-does-not-import-sqlalchemy]
name = webauth persists nothing itself
type = forbidden
source_modules =
    webauth
forbidden_modules =
    sqlalchemy

# The JWT verifier is reached only through the OpenID Connect relying party,
# the cryptographic stack only through the verifier, and urllib3 only through
# the one HTTPS client, so the `jwt` extra stays one narrow edge a
# host that does not sign in through OpenID Connect never imports, and every
# outbound request holds one bounded posture.
[importlinter:contract:only-oidc-imports-jwt-verification]
name = only webauth.oidc imports webauth.jwt_verification
type = protected
protected_modules =
    webauth.jwt_verification
allowed_importers =
    webauth.oidc

[importlinter:contract:only-jwt-verification-imports-the-crypto-stack]
name = only webauth.jwt_verification imports jwt and cryptography
type = protected
protected_modules =
    jwt
    cryptography
allowed_importers =
    webauth.jwt_verification

[importlinter:contract:only-the-https-client-imports-urllib3]
name = only webauth.https_client imports urllib3
type = protected
protected_modules =
    urllib3
allowed_importers =
    webauth.https_client

[importlinter:contract:only-key-set-and-token-transport-import-the-https-client]
name = webauth.https_client is imported only by jwt_verification and oidc_login
type = protected
protected_modules =
    webauth.https_client
allowed_importers =
    webauth.jwt_verification
    webauth.oidc_login

# redis is the optional `[redis]` extra; only the Redis backend's module may reach it.
[importlinter:contract:only-the-rate-limit-module-imports-redis]
name = only webauth.rate_limit imports redis
type = protected
protected_modules =
    redis
allowed_importers =
    webauth.rate_limit
