# The library holds no schema and no ORM of its own: everything durable reaches it
# through the ports the host application implements, and the optional Postgres
# module is the one place that reaches SQLAlchemy. quality's CI gate (its
# import-contract rule) checks these contracts over the real import graph, so
# an indirect chain is caught as well as a direct import.
[importlinter]
include_external_packages = True
root_packages =
    webauth

[importlinter:contract:only-the-postgres-module-imports-sqlalchemy]
name = only webauth.postgres imports sqlalchemy
type = protected
protected_modules =
    sqlalchemy
allowed_importers =
    webauth.postgres

# The Postgres module is the optional `[postgres]` extra for the session half. No webauth
# module imports it, so a host without the extra imports every other module.
[importlinter:contract:no-webauth-module-imports-the-postgres-module]
name = webauth.postgres is imported by no other webauth module
type = protected
protected_modules =
    webauth.postgres
allowed_importers =
    webauth.postgres

# The composition call is a leaf the host imports: no webauth module reaches back
# into the handle it builds.
[importlinter:contract:no-webauth-module-imports-the-composition-call]
name = webauth.web_auth is imported by no other webauth module
type = protected
protected_modules =
    webauth.web_auth
allowed_importers =
    webauth.web_auth

# The JWT verifier is reached only through the OpenID Connect relying party
# and the service caller check, the cryptographic stack only through the
# verifier, and urllib3 only through the one HTTPS client, so each of them has
# one owner, and every outbound request holds one bounded posture.
[importlinter:contract:only-oidc-and-service-callers-import-jwt-verification]
name = only oidc and service_callers import webauth.jwt_verification
type = protected
protected_modules =
    webauth.jwt_verification
allowed_importers =
    webauth.oidc
    webauth.service_callers

[importlinter:contract:only-jwt-verification-imports-the-crypto-stack]
name = only webauth.jwt_verification imports jwt and cryptography
type = protected
protected_modules =
    jwt
    cryptography
allowed_importers =
    webauth.jwt_verification

[importlinter:contract:only-the-https-client-imports-urllib3]
name = only webauth.https_client imports urllib3
type = protected
protected_modules =
    urllib3
allowed_importers =
    webauth.https_client

# webauth.oidc_transport's token request is the one caller that sends through
# the HTTPS client; the key-set fetch is the client's own
# fetch_key_set_over_https, injected by the host. webauth.jwt_verification
# and webauth.oidc import only the client's vocabulary and send nothing
# themselves: their key-set fetch and token request arrive injected.
# webauth.web_auth names the HTTPS fetch and post as the defaults of IssuerCalls.
[importlinter:contract:only-the-verifier-the-relying-party-and-the-token-transport-import-the-https-client]
name = webauth.https_client is imported only by jwt_verification, oidc_transport, oidc and web_auth
type = protected
protected_modules =
    webauth.https_client
allowed_importers =
    webauth.jwt_verification
    webauth.oidc_transport
    webauth.oidc
    webauth.web_auth

# redis is the optional `[redis]` extra; only the Redis backend's module may reach it.
[importlinter:contract:only-the-rate-limit-module-imports-redis]
name = only webauth.rate_limit imports redis
type = protected
protected_modules =
    redis
allowed_importers =
    webauth.rate_limit

# webauth.admission is the leaf the sign-in steps, the bearer gate and services all
# apply, so it imports only the standard library: no other webauth module and no
# third-party runtime dependency (the existing contracts hold jwt, cryptography, urllib3 and redis).
[importlinter:contract:admission-imports-only-the-standard-library]
name = webauth.admission imports no other webauth module and no third-party runtime dependency
type = forbidden
source_modules =
    webauth.admission
forbidden_modules =
    webauth.*
    fastapi
    starlette
    pydantic
    anyio

# webauth._bearer_admission is the leaf below every reader of the bearer gate's record (the
# session readers, both gates and the CSRF check), so it reaches none of them: importing
# webauth.middleware runs the bearer gate, which imports webauth.dependencies.
[importlinter:contract:the-bearer-admission-leaf-imports-no-reader]
name = webauth._bearer_admission imports no reader of its record
type = forbidden
source_modules =
    webauth._bearer_admission
forbidden_modules =
    webauth.dependencies
    webauth.middleware
    webauth.oidc_login

# The bearer gate admits accounts through webauth._account_provisioning, so no middleware module
# reaches into the sign-in steps.
[importlinter:contract:middleware-imports-no-sign-in-step]
name = webauth.middleware imports neither webauth.oidc_login nor webauth.sign_in_routes
type = forbidden
source_modules =
    webauth.middleware
forbidden_modules =
    webauth.oidc_login
    webauth.sign_in_routes

# The single-process stores are a host's choice for one worker. No webauth
# module imports them, so the library never falls back to them.
[importlinter:contract:no-webauth-module-imports-the-single-process-stores]
name = webauth.single_process_stores is imported by no other webauth module
type = protected
protected_modules =
    webauth.single_process_stores
allowed_importers =
    webauth.single_process_stores
